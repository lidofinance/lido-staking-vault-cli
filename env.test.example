# Integration Test Configuration
# Copy this file to .env.test and fill in your values

# Deployed contracts file name (from configs/ directory)
DEPLOYED=deployed-mainnet-vaults.json

# Chain ID for the fork
CHAIN_ID=1

# RPC URL for forking (the original chain, not Anvil)
EL_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Private key for transactions (without 0x prefix is also OK)
PRIVATE_KEY=0x...

# Vault address to test with
VAULT_ADDRESS=0x...

# Optional: Block number to fork from (if not set, forks from latest)
FORK_BLOCK_NUMBER=18000000

# Optional: Anvil port (default: 8545)
ANVIL_PORT=8545


